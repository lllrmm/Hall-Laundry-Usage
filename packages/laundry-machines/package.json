{
  "name": "hkust-laundry-machines",
  "version": "0.1.0",
  "description": "Read-only client for the HKUST laundry system: query real-time washer/dryer status (available, in use, remaining time).",
  "keywords": [
    "hkust",
    "laundry",
    "washer",
    "dryer",
    "api-client"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "laundry-machines": "./bin/cli.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/",
    "test:in-process": "node --test-isolation=none --test test/normalize.test.mjs test/client.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/live-smoke.mjs"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
